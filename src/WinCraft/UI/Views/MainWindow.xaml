<ui:ChromeWindow x:Class="WinCraft.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:WinCraft.UI"
                 Title="WinCraft"
                 Width="800"
                 Height="450"
                 Background="{DynamicResource BgDefault}"
                 WindowStartupLocation="CenterScreen">
    <ui:SpacingStackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ui:LayoutTokens.Spacing="XSmall">
        <TextBlock HorizontalAlignment="Center"
                   Style="{DynamicResource TitleTextBlockStyle}"
                   Text="WinCraft" />
        <TextBlock HorizontalAlignment="Center"
                   ui:Design.VisualRole="Secondary"
                   Text="Craft Windows your way" />
    </ui:SpacingStackPanel>
</ui:ChromeWindow>
