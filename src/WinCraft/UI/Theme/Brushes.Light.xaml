    <SolidColorBrush x:Key="TextTertiary" Color="#990B0B0C" />
    <SolidColorBrush x:Key="TextPlaceholder" Color="#800B0B0C" />
    <SolidColorBrush x:Key="TextDisabled" Color="#730B0B0C" />
    <SolidColorBrush x:Key="TextOnColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnPrimarySolid" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderDefault" Color="#150B0B0C" />
