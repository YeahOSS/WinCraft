<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:WinCraft.UI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.Common.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <sys:Double x:Key="SwitchWidthNormal">48</sys:Double>
    <sys:Double x:Key="SwitchHeightNormal">24</sys:Double>
    <sys:Double x:Key="SwitchThumbSizeNormal">16</sys:Double>
    <Thickness x:Key="SwitchThumbMargin">2</Thickness>
    <CornerRadius x:Key="CornerRadiusSwitchTrack">11</CornerRadius>

    <Style BasedOn="{StaticResource RoleForegroundControlStyle}" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="Padding" Value="0,4,0,4" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource RoleForegroundControlStyle}" TargetType="Expander">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
        <Setter Property="Background" Value="{DynamicResource BgDefault}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessDefault}" />
        <Setter Property="Padding" Value="{StaticResource PaddingNormal}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <ui:SpacingGrid Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    ClipToBounds="True"
                                    CornerRadius="{TemplateBinding ui:Design.CornerRadius}">
                        <ui:SuperellipseBorder x:Name="HeaderHoverBg"
                                               Height="{Binding ActualHeight, ElementName=HeaderToggle}"
                                               VerticalAlignment="Top"
                                               Background="{DynamicResource TransparentBrush}"
                                               CornerRadius="{TemplateBinding ui:Design.CornerRadius}" />
                        <ui:SpacingStackPanel ui:LayoutTokens.Spacing="None">
                            <ToggleButton x:Name="HeaderToggle"
                                          Padding="12,10"
                                          Background="{DynamicResource TransparentBrush}"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Padding="{TemplateBinding Padding}" Background="{DynamicResource TransparentBrush}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Small" Orientation="Horizontal">
                                    <Border Width="{StaticResource FontSizeIconNormal}"
                                            Height="{StaticResource FontSizeIconNormal}"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                        </Border.RenderTransform>
                                        <ui:IconBlock x:Name="Chevron"
                                                      Width="{StaticResource FontSizeIconNormal}"
                                                      Height="{StaticResource FontSizeIconNormal}"
                                                      FontSize="{StaticResource FontSizeIconNormal}"
                                                      Icon="ChevronRight16" />
                                    </Border>
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      TextElement.FontWeight="SemiBold" />
                                </ui:SpacingStackPanel>
                            </ToggleButton>
                            <ContentPresenter x:Name="Content"
                                              Margin="{TemplateBinding Padding}"
                                              Visibility="Collapsed" />
                        </ui:SpacingStackPanel>
                    </ui:SpacingGrid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource ChevronExpand}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource ChevronCollapse}" />
                            </Trigger.ExitActions>
                            <Setter TargetName="Content" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderHoverBg" Property="CornerRadius" Value="{StaticResource CornerRadiusNormalTop}" />
                        </Trigger>
                        <Trigger SourceName="HeaderToggle" Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderHoverBg" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TreeView">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="{StaticResource PaddingSmall}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <ScrollViewer Margin="{TemplateBinding Padding}"
                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TreeViewItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ui:Design.CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <ui:SpacingStackPanel ui:LayoutTokens.Spacing="None">
                        <ui:SuperellipseBorder x:Name="Border"
                                               Padding="{TemplateBinding Padding}"
                                               Background="{DynamicResource TransparentBrush}"
                                               CornerRadius="{TemplateBinding ui:Design.CornerRadius}">
                            <ui:SpacingDockPanel LastChildFill="True">
                                <ToggleButton x:Name="ExpandButton"
                                              Width="{StaticResource FontSizeIconNormal}"
                                              Height="{StaticResource FontSizeIconNormal}"
                                              ClickMode="Press"
                                              Focusable="False"
                                              Foreground="{TemplateBinding Foreground}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Style="{x:Null}"
                                              Visibility="Collapsed">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <ui:IconBlock x:Name="ChevronIcon"
                                                          Width="{StaticResource FontSizeIconSmall}"
                                                          Height="{StaticResource FontSizeIconSmall}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          FontSize="{StaticResource FontSizeIconSmall}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          Icon="ChevronRight16"
                                                          RenderTransformOrigin="0.5,0.5">
                                                <ui:IconBlock.RenderTransform>
                                                    <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                                </ui:IconBlock.RenderTransform>
                                            </ui:IconBlock>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard Storyboard="{StaticResource ChevronExpand}" />
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard Storyboard="{StaticResource ChevronCollapse}" />
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ui:IconBlock x:Name="Icon"
                                              Width="{StaticResource FontSizeIconNormal}"
                                              Height="{StaticResource FontSizeIconNormal}"
                                              Margin="{StaticResource IconTrailingMargin}"
                                              FontSize="{StaticResource FontSizeIconNormal}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Icon="{TemplateBinding ui:Design.Icon}" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  ContentSource="Header"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </ui:SpacingDockPanel>
                        </ui:SuperellipseBorder>
                        <ItemsPresenter x:Name="ItemsHost"
                                        Margin="20,0,0,0"
                                        Visibility="Collapsed" />
                    </ui:SpacingStackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="ExpandButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <Binding ElementName="Border" Path="IsMouseOver" />
                            </DataTrigger.Binding>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentSelectionBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="ui:Design.Icon" Value="None">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlCheckedDisabledBackground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListView">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ui:Design.CornerRadius" Value="{StaticResource CornerRadiusNormal}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="Background" Value="{DynamicResource BgDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessDefault}" />
        <Setter Property="Padding" Value="{StaticResource PaddingSmall}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <ui:SuperellipseBorder Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="{TemplateBinding ui:Design.CornerRadius}">
                        <ScrollViewer Padding="{TemplateBinding Padding}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ui:SuperellipseBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource BgTertiary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Background" Value="{DynamicResource BgSecondary}" />
        <Setter Property="Padding" Value="{StaticResource RowPadding}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Separator}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessDefault}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <ui:SpacingDockPanel Background="{TemplateBinding Background}" LastChildFill="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          RecognizesAccessKey="True" />
                        <Thumb x:Name="PART_HeaderGripper"
                               Width="{StaticResource SpacingXSmall}"
                               HorizontalAlignment="Right"
                               Cursor="SizeWE"
                               Visibility="Visible">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{DynamicResource TransparentBrush}" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </ui:SpacingDockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource RowControlStyle}" TargetType="ListViewItem">
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="ui:Design.CornerRadius" Value="{StaticResource CornerRadiusXSmall}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorWeak}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ui:SuperellipseBorder x:Name="Border"
                                           Padding="{TemplateBinding Padding}"
                                           Background="{DynamicResource TransparentBrush}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="{TemplateBinding ui:Design.CornerRadius}">
                        <GridViewRowPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </ui:SuperellipseBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentSelectionBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlCheckedDisabledBackground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource RoleForegroundControlStyle}" TargetType="ui:Switch">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessDefault}" />
        <Setter Property="Width" Value="{StaticResource SwitchWidthNormal}" />
        <Setter Property="Height" Value="{StaticResource SwitchHeightNormal}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Switch">
                    <ui:SuperellipseBorder x:Name="Border"
                                           Background="{DynamicResource ControlPressedBackground}"
                                           BorderBrush="{DynamicResource TransparentBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="{StaticResource CornerRadiusSwitchTrack}"
                                           SnapsToDevicePixels="True">
                        <ui:SuperellipseBorder x:Name="Thumb"
                                               Width="{StaticResource SwitchThumbSizeNormal}"
                                               Height="{StaticResource SwitchThumbSizeNormal}"
                                               Margin="{StaticResource SwitchThumbMargin}"
                                               HorizontalAlignment="Left"
                                               Background="{DynamicResource ControlThumbBackground}"
                                               CornerRadius="{StaticResource CornerRadiusSmall}" />
                    </ui:SuperellipseBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Primary}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderHover}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource PrimarySolidPressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlDisabledBackground}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderDisabled}" />
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource BgTertiary}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlCheckedDisabledBackground}" />
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource TextDisabled}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
