<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:WinCraft.UI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.Common.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <sys:Double x:Key="MenuPopupMinWidth">160</sys:Double>
    <sys:Double x:Key="MenuIconOnlyMinWidth">40</sys:Double>
    <sys:Double x:Key="MenuIconColumnWidth">28</sys:Double>
    <Thickness x:Key="MenuPopupPadding">0,4</Thickness>
    <Thickness x:Key="MenuItemChromeMargin">4,0</Thickness>
    <Thickness x:Key="MenuGestureMargin">20,0,4,0</Thickness>
    <Style TargetType="Menu">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ui:Design.CornerRadius" Value="{StaticResource CornerRadiusNormal}" />
        <Setter Property="Background" Value="{DynamicResource BgSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Separator}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="-4,0" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightNormal}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <ui:SuperellipseBorder Padding="{TemplateBinding Padding}"
                                           Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="{TemplateBinding ui:Design.CornerRadius}"
                                           SnapsToDevicePixels="True">
                        <ItemsPresenter x:Name="ItemsPresenter"
                                        KeyboardNavigation.TabIndex="0"
                                        KeyboardNavigation.TabNavigation="Continue" />
                    </ui:SuperellipseBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="ui:Design.CornerRadius" Value="{StaticResource CornerRadiusNormal}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessDefault}" />
        <Setter Property="Padding" Value="{StaticResource MenuPopupPadding}" />
        <Setter Property="MinWidth" Value="{StaticResource MenuPopupMinWidth}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <ui:SuperellipseBorder Margin="{StaticResource PopupShadowMargin}"
                                           Padding="{TemplateBinding Padding}"
                                           Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="{TemplateBinding ui:Design.CornerRadius}"
                                           Effect="{StaticResource PopupShadowEffect}"
                                           SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </ui:SuperellipseBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource RowControlStyle}" TargetType="MenuItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <ui:SuperellipseBorder x:Name="Border"
                                               Margin="{StaticResource MenuItemChromeMargin}"
                                               Background="{TemplateBinding Background}"
                                               BorderBrush="{DynamicResource TransparentBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="{TemplateBinding ui:Design.CornerRadius}"
                                               SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition x:Name="SubMenuArrowColumn" Width="24" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="IconHost"
                                      Grid.Column="0"
                                      Width="{StaticResource MenuIconColumnWidth}">
                                    <ui:IconBlock x:Name="Icon"
                                                  Width="{StaticResource FontSizeIconNormal}"
                                                  Height="{StaticResource FontSizeIconNormal}"
                                                  FontSize="{StaticResource FontSizeIconNormal}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Icon="{TemplateBinding ui:Design.Icon}" />
                                    <ui:IconBlock x:Name="CheckGlyph"
                                                  Width="{StaticResource FontSizeIconLarge}"
                                                  Height="{StaticResource FontSizeIconLarge}"
                                                  FontSize="{StaticResource FontSizeIconLarge}"
                                                  Foreground="{DynamicResource Primary}"
                                                  Icon="Checkmark20"
                                                  Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter x:Name="HeaderHost"
                                                  Grid.Column="1"
                                                  Margin="{TemplateBinding Padding}"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                                        </Style>
                                        <Style TargetType="AccessText">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <TextBlock x:Name="GestureText"
                                           Grid.Column="2"
                                           Margin="{StaticResource MenuGestureMargin}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiary}"
                                           Text="{TemplateBinding InputGestureText}" />
                                <ui:IconBlock x:Name="SubMenuArrow"
                                              Grid.Column="3"
                                              Width="{StaticResource FontSizeIconNormal}"
                                              Height="{StaticResource FontSizeIconNormal}"
                                              ui:Design.IsIconFilled="True"
                                              FontSize="{StaticResource FontSizeIconNormal}"
                                              Foreground="{DynamicResource TextTertiary}"
                                              Icon="ChevronRight16" />
                            </Grid>
                        </ui:SuperellipseBorder>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               HorizontalOffset="-2"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Right"
                               PopupAnimation="Fade">
                            <ui:SuperellipseBorder MinWidth="{StaticResource MenuPopupMinWidth}"
                                                   Margin="{StaticResource PopupShadowMargin}"
                                                   Padding="{StaticResource MenuPopupPadding}"
                                                   Background="{DynamicResource PopupBackground}"
                                                   BorderBrush="{DynamicResource PopupBorder}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   CornerRadius="{TemplateBinding ui:Design.CornerRadius}"
                                                   Effect="{StaticResource PopupShadowEffect}"
                                                   SnapsToDevicePixels="True">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </ui:SuperellipseBorder>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlPressedBackground}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0" />
                            <Setter TargetName="SubMenuArrowColumn" Property="Width" Value="0" />
                            <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="SubMenuArrowColumn" Property="Width" Value="0" />
                            <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Role" Value="TopLevelHeader" />
                                <Condition Property="ui:MenuLayout.IsIconOnly" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="MinWidth" Value="{StaticResource MenuIconOnlyMinWidth}" />
                            <Setter TargetName="IconHost" Property="Grid.ColumnSpan" Value="4" />
                            <Setter TargetName="IconHost" Property="Width" Value="Auto" />
                            <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Role" Value="TopLevelItem" />
                                <Condition Property="ui:MenuLayout.IsIconOnly" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="MinWidth" Value="{StaticResource MenuIconOnlyMinWidth}" />
                            <Setter TargetName="IconHost" Property="Grid.ColumnSpan" Value="4" />
                            <Setter TargetName="IconHost" Property="Width" Value="Auto" />
                            <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsCheckable" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
