<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:WinCraft.UI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.Common.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource RowControlStyle}" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="Background" Value="{DynamicResource ControlInputBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <ui:SpacingDockPanel Background="{DynamicResource TransparentBrush}"
                                         LastChildFill="True"
                                         Spacing="{StaticResource SpacingXSmall}">
                        <Grid Width="{StaticResource FontSizeIconLarge}"
                              Height="{StaticResource FontSizeIconLarge}"
                              VerticalAlignment="Center"
                              ui:SpacingDockPanel.Dock="Left">
                            <ui:IconBlock x:Name="CheckGlyph"
                                          Width="{StaticResource FontSizeIconLarge}"
                                          Height="{StaticResource FontSizeIconLarge}"
                                          FontSize="{StaticResource FontSizeIconLarge}"
                                          Foreground="{TemplateBinding BorderBrush}"
                                          Icon="CheckboxUnchecked20"
                                          RenderTransform="{x:Null}" />
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </ui:SpacingDockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Foreground" Value="{DynamicResource BorderActive}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Icon" Value="CheckboxChecked20" />
                            <Setter TargetName="CheckGlyph" Property="Foreground" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="CheckGlyph" Property="Icon" Value="CheckboxIndeterminate20" />
                            <Setter TargetName="CheckGlyph" Property="Foreground" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckGlyph" Property="Foreground" Value="{DynamicResource ControlCheckedDisabledGlyph}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckGlyph" Property="Foreground" Value="{DynamicResource ControlCheckedDisabledGlyph}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource RowControlStyle}" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="Background" Value="{DynamicResource ControlInputBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <ui:SpacingDockPanel Background="{DynamicResource TransparentBrush}"
                                         LastChildFill="True"
                                         Spacing="{StaticResource SpacingXSmall}">
                        <Grid Width="{StaticResource FontSizeIconLarge}"
                              Height="{StaticResource FontSizeIconLarge}"
                              VerticalAlignment="Center"
                              ui:SpacingDockPanel.Dock="Left">
                            <ui:IconBlock x:Name="RadioGlyph"
                                          Width="{StaticResource FontSizeIconLarge}"
                                          Height="{StaticResource FontSizeIconLarge}"
                                          FontSize="{StaticResource FontSizeIconLarge}"
                                          Foreground="{TemplateBinding BorderBrush}"
                                          Icon="RadioButton20"
                                          RenderTransform="{x:Null}" />
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </ui:SpacingDockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RadioGlyph" Property="Foreground" Value="{DynamicResource BorderActive}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioGlyph" Property="ui:Design.IsIconFilled" Value="True" />
                            <Setter TargetName="RadioGlyph" Property="Foreground" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RadioGlyph" Property="Foreground" Value="{DynamicResource ControlCheckedDisabledGlyph}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
