<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="TransparentBrush" Color="#00FFFFFF" />

    <DrawingBrush x:Key="ColorPickerTransparencyBrush"
                  TileMode="Tile"
                  Viewport="0,0,8,8"
                  ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF2A2A2D" Geometry="M0,0 H8 V8 H0 Z" />
                <GeometryDrawing Brush="#FF202023">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,4,4" />
                            <RectangleGeometry Rect="4,4,4,4" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <sys:Boolean x:Key="WindowDwmUseDarkMode">True</sys:Boolean>
    <Color x:Key="WindowDwmCaptionColor">#1E1E20</Color>
    <Color x:Key="WindowDwmTextColor">#FFFFFF</Color>
    <Color x:Key="WindowAcrylicGradientColor">#CC1E1E20</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E20" />
    <Color x:Key="PopupShadowColor">#000000</Color>
    <sys:Double x:Key="PopupShadowOpacity">0.4</sys:Double>
    <SolidColorBrush x:Key="BgDefault" Color="#1E1E20" />
    <SolidColorBrush x:Key="BgSecondary" Color="#171719" />
    <SolidColorBrush x:Key="BgTertiary" Color="#121214" />
    <SolidColorBrush x:Key="BgOverlay" Color="#CC000000" />
    <SolidColorBrush x:Key="TextDefault" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="TextTertiary" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="TextPlaceholder" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="TextDisabled" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="TextOnColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnPrimarySolid" Color="#0B0B0C" />
    <SolidColorBrush x:Key="BorderDefault" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="BorderHover" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="BorderDisabled" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="BorderStrong" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="BorderActive" Color="#398BFF" />
    <SolidColorBrush x:Key="FocusRing" Color="#99398BFF" />
