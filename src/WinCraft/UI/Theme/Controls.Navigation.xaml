<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:WinCraft.UI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.Common.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="ListBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ui:Design.CornerRadius" Value="{StaticResource CornerRadiusNormal}" />
        <Setter Property="Background" Value="{DynamicResource BgDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessDefault}" />
        <Setter Property="Padding" Value="{StaticResource PaddingSmall}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ui:SuperellipseBorder Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="{TemplateBinding ui:Design.CornerRadius}">
                        <ScrollViewer Padding="{TemplateBinding Padding}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ui:SuperellipseBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource BgTertiary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource RowControlStyle}" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessDefault}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ui:SuperellipseBorder x:Name="Border"
                                           Background="{DynamicResource TransparentBrush}"
                                           BorderBrush="{DynamicResource TransparentBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="{TemplateBinding ui:Design.CornerRadius}">
                        <ui:SpacingGrid Margin="{TemplateBinding Padding}"
                                        ColumnSpacing="{StaticResource SpacingSmall}"
                                        Columns="Auto,*">
                            <ui:IconBlock x:Name="Icon"
                                          Width="{StaticResource FontSizeIconNormal}"
                                          Height="{StaticResource FontSizeIconNormal}"
                                          FontSize="{StaticResource FontSizeIconNormal}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Icon="{TemplateBinding ui:Design.Icon}" />
                            <ContentPresenter Grid.Column="1"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </ui:SpacingGrid>
                    </ui:SuperellipseBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource PrimaryBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="ui:Design.Icon" Value="None">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlCheckedDisabledBackground}" />
                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ui:Design.CornerRadius" Value="{StaticResource CornerRadiusNormal}" />
        <Setter Property="Background" Value="{DynamicResource BgDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Separator}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessDefault}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <ui:SuperellipseBorder x:Name="OuterBorder"
                                           Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="{TemplateBinding ui:Design.CornerRadius}"
                                           SnapsToDevicePixels="True">
                        <ui:SpacingGrid KeyboardNavigation.TabNavigation="Local" Rows="Auto,*">
                            <ui:SuperellipseBorder x:Name="HeaderBorder"
                                                   Padding="{StaticResource TabHeaderPadding}"
                                                   Background="{DynamicResource BgSecondary}"
                                                   ClipToBounds="True"
                                                   CornerRadius="{StaticResource CornerRadiusNormalTop}">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" />
                            </ui:SuperellipseBorder>
                            <ui:SuperellipseBorder x:Name="ContentBorder"
                                                   Grid.Row="1"
                                                   Padding="{TemplateBinding Padding}"
                                                   Background="{TemplateBinding Background}"
                                                   CornerRadius="{StaticResource CornerRadiusNormalBottom}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </ui:SuperellipseBorder>
                        </ui:SpacingGrid>
                    </ui:SuperellipseBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource RowControlStyle}" TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <ui:SuperellipseBorder x:Name="Background"
                                               Background="{DynamicResource TransparentBrush}"
                                               CornerRadius="{StaticResource CornerRadiusSmall}" />
                        <ui:SpacingGrid Margin="{TemplateBinding Padding}"
                                        ColumnSpacing="{StaticResource SpacingSmall}"
                                        Columns="Auto,*">
                            <ui:IconBlock x:Name="Icon"
                                          Width="{StaticResource FontSizeIconNormal}"
                                          Height="{StaticResource FontSizeIconNormal}"
                                          FontSize="{StaticResource FontSizeIconNormal}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Icon="{TemplateBinding ui:Design.Icon}" />
                            <ContentPresenter Grid.Column="1"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </ui:SpacingGrid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlSelectedBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="ui:Design.Icon" Value="None">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlCheckedDisabledBackground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
