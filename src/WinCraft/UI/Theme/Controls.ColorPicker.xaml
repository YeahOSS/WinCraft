<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:WinCraft.UI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.Common.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="ColorPickerSliderStyle" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource BorderStrong}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="9,0">
                        <Border Height="10"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ColorPickerTransparencyBrush}"
                                BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="{StaticResource BorderThicknessDefault}"
                                CornerRadius="{StaticResource CornerRadiusTiny}" />
                        <Border Height="10"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="{StaticResource BorderThicknessDefault}"
                                CornerRadius="{StaticResource CornerRadiusTiny}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderTrackButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18"
                                       Height="18"
                                       Focusable="False"
                                       OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="{DynamicResource BgDefault}"
                                                         Stroke="{TemplateBinding Foreground}"
                                                         StrokeThickness="2" />
                                                <Ellipse Margin="5" Fill="{TemplateBinding Foreground}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter Property="Opacity" Value="0.8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderTrackButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ColorPickerDropDownButtonStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="Padding" Value="{StaticResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <ui:SuperellipseBorder x:Name="Border"
                                           Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="{TemplateBinding ui:Design.CornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </ui:SuperellipseBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlInputHoverBackground}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlInputBackground}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderActive}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type ui:ColorPicker}}}" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderActive}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgTertiary}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ColorPickerPresetButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource DialogIconSize}" />
        <Setter Property="Height" Value="{StaticResource DialogIconSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <ui:SuperellipseBorder Background="{DynamicResource ColorPickerTransparencyBrush}" CornerRadius="{StaticResource CornerRadiusSmall}" />
                        <ui:SuperellipseBorder x:Name="Border"
                                               Background="{TemplateBinding Background}"
                                               BorderBrush="{DynamicResource BorderDefault}"
                                               BorderThickness="{StaticResource BorderThicknessDefault}"
                                               CornerRadius="{StaticResource CornerRadiusSmall}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Primary}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Primary}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource InputControlStyle}" TargetType="ui:ColorPicker">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:ColorPicker">
                    <Grid>
                        <ToggleButton x:Name="PART_DropDownButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Style="{StaticResource ColorPickerDropDownButtonStyle}">
                            <ui:SpacingGrid ColumnSpacing="{StaticResource SpacingSmall}" Columns="20,*,16">
                                <Grid Width="{StaticResource FontSizeIconLarge}" Height="{StaticResource FontSizeIconLarge}">
                                    <Border Background="{DynamicResource ColorPickerTransparencyBrush}" CornerRadius="{StaticResource CornerRadiusTiny}" />
                                    <Border x:Name="PART_DisplayPreview"
                                            BorderBrush="{DynamicResource BorderDefault}"
                                            BorderThickness="{StaticResource BorderThicknessDefault}"
                                            CornerRadius="{StaticResource CornerRadiusTiny}" />
                                </Grid>
                                <TextBlock x:Name="PART_DisplayText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <ui:IconBlock x:Name="DropDownIcon"
                                              Grid.Column="2"
                                              Width="{StaticResource FontSizeIconNormal}"
                                              Height="{StaticResource FontSizeIconNormal}"
                                              FontSize="{StaticResource FontSizeIconNormal}"
                                              Foreground="{DynamicResource TextSecondary}"
                                              Icon="ChevronDown16"
                                              RenderTransformOrigin="0.5,0.5">
                                    <ui:IconBlock.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform />
                                            <TranslateTransform Y="{StaticResource IconOpticalOffsetY}" />
                                        </TransformGroup>
                                    </ui:IconBlock.RenderTransform>
                                </ui:IconBlock>
                            </ui:SpacingGrid>
                        </ToggleButton>

                        <Popup x:Name="PART_DropDownPopup"
                               Margin="{StaticResource PopupOffsetMargin}"
                               AllowsTransparency="True"
                               DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               Focusable="False"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade"
                               StaysOpen="True">
                            <ui:SuperellipseBorder Width="352"
                                                   Margin="{StaticResource PopupShadowMargin}"
                                                   Padding="{StaticResource PaddingNormal}"
                                                   Background="{DynamicResource PopupBackground}"
                                                   BorderBrush="{DynamicResource PopupBorder}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   CornerRadius="{TemplateBinding ui:Design.CornerRadius}"
                                                   Effect="{StaticResource PopupShadowEffect}"
                                                   SnapsToDevicePixels="True">
                                <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                                    <Border x:Name="PART_ColorPlane"
                                            Height="176"
                                            BorderBrush="{DynamicResource BorderDefault}"
                                            BorderThickness="{StaticResource BorderThicknessDefault}"
                                            ClipToBounds="True"
                                            Cursor="Cross">
                                        <Grid>
                                            <Rectangle IsHitTestVisible="False">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="White" />
                                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle IsHitTestVisible="False">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#00000000" />
                                                        <GradientStop Offset="1" Color="Black" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Canvas IsHitTestVisible="False">
                                                <Grid x:Name="PART_ColorPlaneThumb"
                                                      Width="18"
                                                      Height="18">
                                                    <Ellipse Stroke="Black" StrokeThickness="4" />
                                                    <Ellipse Margin="2"
                                                             Stroke="White"
                                                             StrokeThickness="2" />
                                                </Grid>
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <ui:SpacingGrid ColumnSpacing="{StaticResource SpacingSmall}" Columns="20,*">
                                        <ui:IconBlock Width="{StaticResource FontSizeIconNormal}"
                                                      Height="{StaticResource FontSizeIconNormal}"
                                                      VerticalAlignment="Center"
                                                      FontSize="{StaticResource FontSizeIconNormal}"
                                                      Foreground="{DynamicResource TextSecondary}"
                                                      Icon="ColorLine16" />
                                        <Slider x:Name="PART_HueSlider"
                                                Grid.Column="1"
                                                LargeChange="15"
                                                Maximum="360"
                                                SmallChange="1"
                                                Style="{StaticResource ColorPickerSliderStyle}" />
                                    </ui:SpacingGrid>

                                    <ui:SpacingGrid x:Name="AlphaRow"
                                                    ColumnSpacing="{StaticResource SpacingSmall}"
                                                    Columns="20,*">
                                        <ui:IconBlock Width="{StaticResource FontSizeIconNormal}"
                                                      Height="{StaticResource FontSizeIconNormal}"
                                                      VerticalAlignment="Center"
                                                      FontSize="{StaticResource FontSizeIconNormal}"
                                                      Foreground="{DynamicResource TextSecondary}"
                                                      Icon="TransparencySquare16" />
                                        <Slider x:Name="PART_AlphaSlider"
                                                Grid.Column="1"
                                                LargeChange="16"
                                                Maximum="255"
                                                SmallChange="1"
                                                Style="{StaticResource ColorPickerSliderStyle}" />
                                    </ui:SpacingGrid>

                                    <Separator />

                                    <ui:SpacingGrid ColumnSpacing="{StaticResource SpacingSmall}" Columns="auto,*">
                                        <ComboBox x:Name="ModeComboBox"
                                                  Width="78"
                                                  MinWidth="0"
                                                  Padding="{StaticResource CompactInputPadding}"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Hex" />
                                            <ComboBoxItem x:Name="ArgbModeItem" Content="ARGB" />
                                        </ComboBox>

                                        <TextBox x:Name="PART_HexTextBox"
                                                 Grid.Column="1"
                                                 InputMethod.IsInputMethodEnabled="False" />

                                        <ui:SpacingUniformGrid x:Name="ArgbRow"
                                                               Grid.Column="1"
                                                               HorizontalAlignment="Stretch"
                                                               Columns="4"
                                                               Spacing="6"
                                                               Visibility="Collapsed">
                                            <ui:NumericBox x:Name="PART_ArgbA"
                                                           MinWidth="0"
                                                           Padding="{StaticResource CompactInputPadding}"
                                                           DecimalPlaces="0"
                                                           InputType="Integer"
                                                           Maximum="255"
                                                           Minimum="0" />
                                            <ui:NumericBox x:Name="PART_ArgbR"
                                                           MinWidth="0"
                                                           Padding="{StaticResource CompactInputPadding}"
                                                           DecimalPlaces="0"
                                                           InputType="Integer"
                                                           Maximum="255"
                                                           Minimum="0" />
                                            <ui:NumericBox x:Name="PART_ArgbG"
                                                           MinWidth="0"
                                                           Padding="{StaticResource CompactInputPadding}"
                                                           DecimalPlaces="0"
                                                           InputType="Integer"
                                                           Maximum="255"
                                                           Minimum="0" />
                                            <ui:NumericBox x:Name="PART_ArgbB"
                                                           MinWidth="0"
                                                           Padding="{StaticResource CompactInputPadding}"
                                                           DecimalPlaces="0"
                                                           InputType="Integer"
                                                           Maximum="255"
                                                           Minimum="0" />
                                        </ui:SpacingUniformGrid>
                                    </ui:SpacingGrid>

                                    <Separator />

                                    <ui:SpacingWrapPanel Spacing="6">
                                        <ui:SpacingWrapPanel.Resources>
                                            <Style BasedOn="{StaticResource ColorPickerPresetButtonStyle}" TargetType="Button">
                                                <Setter Property="Command" Value="{x:Static ui:ColorPicker.SelectPresetCommand}" />
                                                <Setter Property="CommandTarget" Value="{Binding}" />
                                            </Style>
                                        </ui:SpacingWrapPanel.Resources>
                                        <Button Background="#FF000000" CommandParameter="#000000" />
                                        <Button Background="#FFFFFFFF" CommandParameter="#FFFFFF" />
                                        <Button Background="#FF7F7F7F" CommandParameter="#7F7F7F" />
                                        <Button Background="#FFDC2846" CommandParameter="#DC2846" />
                                        <Button Background="#FFEC671F" CommandParameter="#EC671F" />
                                        <Button Background="#FFF2C94C" CommandParameter="#F2C94C" />
                                        <Button Background="#FF0D9E51" CommandParameter="#0D9E51" />
                                        <Button Background="#FF00B7C3" CommandParameter="#00B7C3" />
                                        <Button Background="#FF1474F2" CommandParameter="#1474F2" />
                                        <Button Background="#FF7B61FF" CommandParameter="#7B61FF" />
                                        <Button Background="#FFE74769" CommandParameter="#E74769" />
                                    </ui:SpacingWrapPanel>
                                </ui:SpacingStackPanel>
                            </ui:SuperellipseBorder>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsAlphaEnabled" Value="False">
                            <Setter TargetName="AlphaRow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_ArgbA" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArgbRow" Property="Columns" Value="3" />
                            <Setter TargetName="ArgbModeItem" Property="Content" Value="RGB" />
                        </Trigger>
                        <Trigger Property="IsAlphaEnabled" Value="True">
                            <Setter TargetName="ArgbRow" Property="Columns" Value="4" />
                            <Setter TargetName="ArgbModeItem" Property="Content" Value="ARGB" />
                        </Trigger>
                        <Trigger SourceName="ModeComboBox" Property="SelectedIndex" Value="1">
                            <Setter TargetName="PART_HexTextBox" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArgbRow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="PART_DropDownButton" Property="IsChecked" Value="True">
                            <Setter TargetName="DropDownIcon" Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <RotateTransform Angle="180" />
                                        <TranslateTransform Y="{StaticResource IconOpticalOffsetY}" />
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
