<ui:TabWindow x:Class="WinCraft.Gallery.Views.MainWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:gallery="clr-namespace:WinCraft.Gallery.Controls"
              xmlns:ui="clr-namespace:WinCraft.UI;assembly=WinCraft"
              xmlns:vm="clr-namespace:WinCraft.Gallery.ViewModels"
              Title="{Binding SelectedTab.Title}"
              Width="1200"
              Height="800"
              MinWidth="800"
              MinHeight="560"
              BackdropType="Mica"
              HomeTab="{Binding HomeTab}"
              SelectedTab="{Binding SelectedTab, Mode=TwoWay}"
              ShowNewTabButton="False"
              TabMaxWidth="220"
              TabMinWidth="112"
              Tabs="{Binding Tabs}"
              WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <ui:TabWindow.TitleBarFooter>
        <StackPanel Orientation="Horizontal">
            <ui:TitleBarButton Command="{Binding ToggleUiPageEnabledCommand}" ToolTip="Enable or disable page controls">
                <ui:TitleBarButton.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:TitleBarButton}}" TargetType="{x:Type ui:TitleBarButton}">
                        <Setter Property="Icon" Value="LockOpen20" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUiPageEnabled}" Value="False">
                                <Setter Property="Icon" Value="LockClosed20" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:TitleBarButton.Style>
            </ui:TitleBarButton>
            <ui:TitleBarButton Click="ThemeButton_Click"
                               Icon="Color20"
                               ToolTip="Theme">
                <ui:TitleBarButton.ContextMenu>
                    <ContextMenu>
                        <MenuItem ui:Design.Icon="Desktop20"
                                  Command="{Binding PlacementTarget.DataContext.SetThemeModeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandParameter="{x:Static ui:ThemeMode.Auto}"
                                  Header="Follow system"
                                  IsCheckable="True"
                                  IsChecked="{Binding PlacementTarget.DataContext.IsFollowingSystemTheme, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem ui:Design.Icon="BrightnessHigh20"
                                  Command="{Binding PlacementTarget.DataContext.SetThemeModeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandParameter="{x:Static ui:ThemeMode.Light}"
                                  Header="Light"
                                  IsCheckable="True"
                                  IsChecked="{Binding PlacementTarget.DataContext.IsLightTheme, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem ui:Design.Icon="DarkTheme20"
                                  Command="{Binding PlacementTarget.DataContext.SetThemeModeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandParameter="{x:Static ui:ThemeMode.Dark}"
                                  Header="Dark"
                                  IsCheckable="True"
                                  IsChecked="{Binding PlacementTarget.DataContext.IsDarkTheme, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    </ContextMenu>
                </ui:TitleBarButton.ContextMenu>
            </ui:TitleBarButton>
        </StackPanel>
    </ui:TabWindow.TitleBarFooter>

    <ui:TabWindow.TabHeaderTemplate>
        <DataTemplate>
            <Grid MinWidth="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:IconBlock x:Name="TabIcon"
                              Width="16"
                              Height="16"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource Primary}"
                              Icon="{Binding Icon}" />
                <TextBlock x:Name="TabTitle"
                           Grid.Column="1"
                           Margin="8,0,6,0"
                           VerticalAlignment="Center"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis" />
                <ui:IconButton x:Name="CloseTabButton"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               ui:Design.Variant="Ghost"
                               Command="{Binding CloseTabCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:TabWindow}}}"
                               CommandParameter="{Binding}"
                               Focusable="False"
                               Icon="Dismiss20"
                               IsCircular="True"
                               IsSmall="True"
                               IsTabStop="False" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type ui:WindowTabItem}}}" Value="True">
                    <Setter TargetName="TabTitle" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CloseTabButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type ui:WindowTabItem}}}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ui:WindowTabItem}}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="CloseTabButton" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsHomeTab, RelativeSource={RelativeSource AncestorType={x:Type ui:WindowTabItem}}}" Value="True">
                    <Setter TargetName="TabIcon" Property="Grid.ColumnSpan" Value="3" />
                    <Setter TargetName="TabIcon" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="TabTitle" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CloseTabButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ui:TabWindow.TabHeaderTemplate>

    <ui:TabWindow.TabContentTemplate>
        <DataTemplate>
            <ContentPresenter Content="{Binding Content, Converter={gallery:TypeToViewConverter}}" IsEnabled="{Binding DataContext.IsUiPageEnabled, RelativeSource={RelativeSource AncestorType={x:Type ui:TabWindow}}}" />
        </DataTemplate>
    </ui:TabWindow.TabContentTemplate>
</ui:TabWindow>
