<UserControl x:Class="WinCraft.Gallery.Views.Pages.NavigationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinCraft.UI;assembly=WinCraft">
    <ScrollViewer>
        <ui:SpacingStackPanel Padding="{StaticResource PagePadding}" ui:LayoutTokens.Spacing="XLarge">

            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Small">
                <TextBlock Style="{DynamicResource TitleTextBlockStyle}" Text="Navigation" />
                <TextBlock ui:Design.VisualRole="Secondary"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Text="TabControl, Menu, and TreeView controls." />
            </ui:SpacingStackPanel>

            <Separator />
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="Menu" />
                <Menu>
                    <MenuItem Header="File">
                        <MenuItem Header="New" InputGestureText="Ctrl+N" />
                        <MenuItem Header="Open" InputGestureText="Ctrl+O" />
                        <Separator />
                        <MenuItem Header="Recent">
                            <MenuItem Header="Project A" />
                            <MenuItem Header="Project B" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="View">
                        <MenuItem Header="Light"
                                  IsCheckable="True"
                                  IsChecked="True" />
                        <MenuItem Header="Dark" IsCheckable="True" />
                    </MenuItem>
                    <MenuItem Header="Help">
                        <MenuItem ui:Design.Icon="QuestionCircle16" Header="About" />
                    </MenuItem>
                </Menu>
                <Button HorizontalAlignment="Left" Content="Right-click for context menu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem ui:Design.Icon="Copy16" Header="Copy" />
                            <MenuItem ui:Design.Icon="Edit16" Header="Rename" />
                            <Separator />
                            <MenuItem ui:Design.Icon="Delete16" Header="Delete" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="TabControl" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Pill-style tabs with icon support." />
                <TabControl Height="160">
                    <TabItem ui:Design.Icon="Settings16" Header="General">
                        <TextBlock Margin="{StaticResource PaddingNormal}" Text="Selected tab content – General settings" />
                    </TabItem>
                    <TabItem Header="Advanced">
                        <TextBlock Margin="{StaticResource PaddingNormal}" Text="Advanced configuration options" />
                    </TabItem>
                    <TabItem Header="Appearance">
                        <TextBlock Margin="{StaticResource PaddingNormal}" Text="Theme and layout customization" />
                    </TabItem>
                    <TabItem Header="Shortcuts">
                        <TextBlock Margin="{StaticResource PaddingNormal}" Text="Keyboard shortcut management" />
                    </TabItem>
                </TabControl>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="TreeView" />
                <TreeView Height="200" MaxWidth="400">
                    <TreeViewItem ui:Design.Icon="Document16"
                                  Header="Documents"
                                  IsExpanded="True">
                        <TreeViewItem ui:Design.Icon="Document16"
                                      Header="Work"
                                      IsExpanded="True">
                            <TreeViewItem ui:Design.Icon="Document16" Header="Report.docx" />
                            <TreeViewItem ui:Design.Icon="Document16" Header="Budget.xlsx" />
                        </TreeViewItem>
                        <TreeViewItem ui:Design.Icon="Document16" Header="Personal">
                            <TreeViewItem ui:Design.Icon="Document16" Header="Resume.pdf" />
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem ui:Design.Icon="Document16" Header="Pictures">
                        <TreeViewItem ui:Design.Icon="Document16" Header="Vacation" />
                        <TreeViewItem ui:Design.Icon="Document16" Header="Family" />
                    </TreeViewItem>
                    <TreeViewItem ui:Design.Icon="Document16" Header="Music" />
                </TreeView>
            </ui:SpacingStackPanel>

        </ui:SpacingStackPanel>
    </ScrollViewer>
</UserControl>
