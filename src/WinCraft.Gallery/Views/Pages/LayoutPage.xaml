<UserControl x:Class="WinCraft.Gallery.Views.Pages.LayoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinCraft.UI;assembly=WinCraft">
    <ScrollViewer>
        <ui:SpacingStackPanel Padding="{StaticResource PagePadding}" ui:LayoutTokens.Spacing="XLarge">

            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Small">
                <TextBlock Style="{DynamicResource TitleTextBlockStyle}" Text="Layout" />
                <TextBlock ui:Design.VisualRole="Secondary"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Text="Spacing panels, separators, containers, and scrolling controls." />
            </ui:SpacingStackPanel>

            <Separator />
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="Separator" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Horizontal and vertical separators, plus the separator used in menu popups." />
                <ui:SpacingStackPanel Padding="{StaticResource CardPadding}"
                                      ui:LayoutTokens.Spacing="Normal"
                                      Background="{DynamicResource ControlFillBackground}"
                                      BorderBrush="{DynamicResource BorderDefault}"
                                      BorderThickness="{StaticResource BorderThicknessDefault}"
                                      CornerRadius="{StaticResource CornerRadiusSmall}">
                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Horizontal" />
                    <TextBlock Text="Content above the separator" />
                    <Separator />
                    <TextBlock Text="Content below the separator" />

                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Vertical" />
                    <ui:SpacingStackPanel Height="40"
                                          ui:LayoutTokens.Spacing="Normal"
                                          Orientation="Horizontal">
                        <TextBlock Text="Left content" />
                        <Separator ui:SeparatorLayout.Orientation="Vertical" />
                        <TextBlock Text="Right content" />
                    </ui:SpacingStackPanel>

                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Menu popup (open File)" />
                    <Menu>
                        <MenuItem Header="File">
                            <MenuItem Header="New" InputGestureText="Ctrl+N" />
                            <MenuItem Header="Open" InputGestureText="Ctrl+O" />
                            <Separator />
                            <MenuItem Header="Recent" />
                        </MenuItem>
                    </Menu>
                </ui:SpacingStackPanel>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="SpacingStackPanel" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Vertical stack with consistent spacing between children." />
                <ui:SpacingStackPanel Padding="{StaticResource PaddingNormal}"
                                      ui:LayoutTokens.Spacing="Small"
                                      Background="{DynamicResource ControlFillBackground}"
                                      BorderBrush="{DynamicResource BorderDefault}"
                                      BorderThickness="{StaticResource BorderThicknessDefault}"
                                      CornerRadius="{StaticResource CornerRadiusSmall}">
                    <Border Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                </ui:SpacingStackPanel>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="SuperellipseBorder" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Container with superellipse corners. Adjust Exponent to control the curve (2 = circle, 4 = default, ∞ = rect). Supports dashed borders via StrokeDashArray." />
                <ui:SpacingWrapPanel ui:LayoutTokens.Spacing="Small">
                    <ui:SuperellipseBorder Width="120"
                                           Height="80"
                                           Padding="{StaticResource PaddingNormal}"
                                           Background="{DynamicResource ControlFillBackground}"
                                           BorderBrush="{DynamicResource BorderDefault}"
                                           BorderThickness="{StaticResource BorderThicknessDefault}"
                                           CornerRadius="{StaticResource CornerRadiusLarge}"
                                           Exponent="2">
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="n = 2" />
                    </ui:SuperellipseBorder>
                    <ui:SuperellipseBorder Width="120"
                                           Height="80"
                                           Padding="{StaticResource PaddingNormal}"
                                           Background="{DynamicResource ControlFillBackground}"
                                           BorderBrush="{DynamicResource BorderDefault}"
                                           BorderThickness="{StaticResource BorderThicknessDefault}"
                                           CornerRadius="{StaticResource CornerRadiusLarge}"
                                           Exponent="4">
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="n = 4" />
                    </ui:SuperellipseBorder>
                    <ui:SuperellipseBorder Width="120"
                                           Height="80"
                                           Padding="{StaticResource PaddingNormal}"
                                           Background="{DynamicResource ControlFillBackground}"
                                           BorderBrush="{DynamicResource BorderDefault}"
                                           BorderThickness="{StaticResource BorderThicknessDefault}"
                                           CornerRadius="{StaticResource CornerRadiusLarge}"
                                           Exponent="8">
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="n = 8" />
                    </ui:SuperellipseBorder>
                    <ui:SuperellipseBorder Width="120"
                                           Height="80"
                                           Padding="{StaticResource PaddingNormal}"
                                           Background="{DynamicResource ControlFillBackground}"
                                           BorderBrush="{DynamicResource Primary}"
                                           BorderThickness="2"
                                           CornerRadius="{StaticResource CornerRadiusLarge}"
                                           StrokeDashArray="4 2">
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Dashed" />
                    </ui:SuperellipseBorder>
                </ui:SpacingWrapPanel>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="SpacingItemsControl" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Items control with a generated spacing stack panel." />
                <ui:SuperellipseBorder MaxWidth="400"
                                       Padding="{StaticResource PaddingNormal}"
                                       Background="{DynamicResource ControlFillBackground}"
                                       BorderBrush="{DynamicResource BorderDefault}"
                                       BorderThickness="{StaticResource BorderThicknessDefault}"
                                       CornerRadius="{StaticResource CornerRadiusSmall}">
                    <ui:SpacingItemsControl ui:LayoutTokens.Spacing="Small" Orientation="Horizontal">
                        <Border Width="80"
                                Height="28"
                                Background="{DynamicResource PrimaryBg}"
                                CornerRadius="{StaticResource CornerRadiusXSmall}" />
                        <Border Width="80"
                                Height="28"
                                Background="{DynamicResource SuccessBg}"
                                CornerRadius="{StaticResource CornerRadiusXSmall}" />
                        <Border Width="80"
                                Height="28"
                                Background="{DynamicResource WarningBg}"
                                CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    </ui:SpacingItemsControl>
                </ui:SuperellipseBorder>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="SpacingDockPanel" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Dock-style layout with spacing. Here: Left, Right, fill." />
                <ui:SpacingDockPanel Height="48"
                                     Padding="{StaticResource PaddingNormal}"
                                     ui:LayoutTokens.Spacing="Small"
                                     Background="{DynamicResource ControlFillBackground}"
                                     BorderBrush="{DynamicResource BorderDefault}"
                                     BorderThickness="{StaticResource BorderThicknessDefault}"
                                     CornerRadius="{StaticResource CornerRadiusSmall}"
                                     LastChildFill="True">
                    <Border Width="40"
                            ui:SpacingDockPanel.Dock="Left"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Width="40"
                            ui:SpacingDockPanel.Dock="Right"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Background="{DynamicResource SuccessBg}" CornerRadius="{StaticResource CornerRadiusXSmall}" />
                </ui:SpacingDockPanel>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="SpacingGrid" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Grid with column and row spacing." />
                <ui:SpacingGrid Padding="{StaticResource PaddingNormal}"
                                Background="{DynamicResource ControlFillBackground}"
                                BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="{StaticResource BorderThicknessDefault}"
                                ColumnSpacing="{StaticResource SpacingNormal}"
                                Columns="*,*,*"
                                CornerRadius="{StaticResource CornerRadiusSmall}"
                                RowSpacing="{StaticResource SpacingNormal}"
                                Rows="auto,auto">
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Height="32"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Height="32"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Grid.Row="0"
                            Grid.Column="2"
                            Height="32"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Height="32"
                            Background="{DynamicResource SuccessBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Height="32"
                            Background="{DynamicResource SuccessBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                </ui:SpacingGrid>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="SpacingWrapPanel" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Wraps children to the next row with spacing." />
                <ui:SpacingWrapPanel Padding="{StaticResource PaddingNormal}"
                                     ui:LayoutTokens.Spacing="Small"
                                     Background="{DynamicResource ControlFillBackground}"
                                     BorderBrush="{DynamicResource BorderDefault}"
                                     BorderThickness="{StaticResource BorderThicknessDefault}"
                                     CornerRadius="{StaticResource CornerRadiusSmall}">
                    <Border Width="200"
                            Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Width="200"
                            Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Width="200"
                            Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Width="200"
                            Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Width="200"
                            Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Width="300"
                            Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Width="100"
                            Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Width="200"
                            Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                </ui:SpacingWrapPanel>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="SpacingUniformGrid" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Uniform grid with equal cell sizes and spacing." />
                <ui:SpacingUniformGrid Padding="{StaticResource PaddingNormal}"
                                       ui:LayoutTokens.Spacing="Small"
                                       Background="{DynamicResource ControlFillBackground}"
                                       BorderBrush="{DynamicResource BorderDefault}"
                                       BorderThickness="{StaticResource BorderThicknessDefault}"
                                       Columns="4"
                                       CornerRadius="{StaticResource CornerRadiusSmall}"
                                       Rows="2">
                    <Border Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Height="28"
                            Background="{DynamicResource PrimaryBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Height="28"
                            Background="{DynamicResource SuccessBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Height="28"
                            Background="{DynamicResource SuccessBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Height="28"
                            Background="{DynamicResource SuccessBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                    <Border Height="28"
                            Background="{DynamicResource SuccessBg}"
                            CornerRadius="{StaticResource CornerRadiusXSmall}" />
                </ui:SpacingUniformGrid>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="Expander" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Collapsible content panel with animated chevron." />
                <Expander MaxWidth="400" Header="Click to expand">
                    <ui:SpacingStackPanel Padding="{StaticResource PaddingNormal}" ui:LayoutTokens.Spacing="Small">
                        <TextBlock Text="This content is hidden by default." />
                        <TextBlock ui:Design.VisualRole="Secondary" Text="The Expander uses an animated chevron icon." />
                    </ui:SpacingStackPanel>
                </Expander>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="Form" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Form container with uniform label width via LabelWidth. Use FormItem for each label-control row." />
                <ui:SuperellipseBorder Padding="{StaticResource PaddingLarge}"
                                       Background="{DynamicResource BgDefault}"
                                       BorderBrush="{DynamicResource BorderDefault}"
                                       BorderThickness="{StaticResource BorderThicknessDefault}"
                                       CornerRadius="{StaticResource CornerRadiusNormal}">
                    <ui:Form MaxWidth="400"
                             ui:LayoutTokens.Spacing="Small"
                             LabelWidth="{StaticResource FormLabelWidth}">
                        <ui:FormItem Header="Username" IsRequired="True">
                            <TextBox ui:TextInput.Watermark="Enter username" />
                        </ui:FormItem>
                        <ui:FormItem Header="Password" IsRequired="True">
                            <PasswordBox ui:PasswordReveal.IsEnabled="True" ui:TextInput.Watermark="Enter password" />
                        </ui:FormItem>
                        <ui:FormItem Header="Country">
                            <ComboBox ui:TextInput.Watermark="Choose a country" SelectedIndex="-1">
                                <ComboBoxItem Content="United States" />
                                <ComboBoxItem Content="China" />
                                <ComboBoxItem Content="Japan" />
                            </ComboBox>
                        </ui:FormItem>
                        <ui:FormItem Header="Notes">
                            <TextBox Height="60"
                                     ui:TextInput.Watermark="Optional notes"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap" />
                        </ui:FormItem>
                    </ui:Form>
                </ui:SuperellipseBorder>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="ScrollViewer" />
                <ui:SuperellipseBorder Width="320"
                                       Height="120"
                                       Background="{DynamicResource ControlFillBackground}"
                                       BorderBrush="{DynamicResource BorderDefault}"
                                       BorderThickness="{StaticResource BorderThicknessDefault}"
                                       ClipToBounds="True"
                                       CornerRadius="{StaticResource CornerRadiusSmall}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Rectangle Width="600"
                                   Height="300"
                                   Opacity="0.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush>
                                    <GradientStop Color="DeepSkyBlue" />
                                    <GradientStop Offset="1" Color="SeaGreen" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </ScrollViewer>
                </ui:SuperellipseBorder>
            </ui:SpacingStackPanel>
            <ui:SpacingStackPanel ui:LayoutTokens.Spacing="Normal">
                <TextBlock Style="{DynamicResource SectionHeaderTextBlockStyle}" Text="IconBlock" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Renders icon glyphs using the icon font. Supports regular and filled variants via ui:Design.IsIconFilled." />
                <ui:SpacingWrapPanel VerticalAlignment="Center" ui:LayoutTokens.Spacing="Normal">
                    <ui:IconBlock FontSize="24"
                                  Foreground="{DynamicResource Primary}"
                                  Icon="Heart24" />
                    <ui:IconBlock ui:Design.IsIconFilled="True"
                                  FontSize="24"
                                  Foreground="{DynamicResource Primary}"
                                  Icon="Heart24" />
                    <ui:IconBlock FontSize="24"
                                  Foreground="{DynamicResource Success}"
                                  Icon="CheckmarkCircle24" />
                    <ui:IconBlock ui:Design.IsIconFilled="True"
                                  FontSize="24"
                                  Foreground="{DynamicResource Success}"
                                  Icon="CheckmarkCircle24" />
                    <ui:IconBlock FontSize="24"
                                  Foreground="{DynamicResource Warning}"
                                  Icon="Warning24" />
                    <ui:IconBlock ui:Design.IsIconFilled="True"
                                  FontSize="24"
                                  Foreground="{DynamicResource Warning}"
                                  Icon="Warning24" />
                    <ui:IconBlock FontSize="24"
                                  Foreground="{DynamicResource Error}"
                                  Icon="Delete24" />
                    <ui:IconBlock ui:Design.IsIconFilled="True"
                                  FontSize="24"
                                  Foreground="{DynamicResource Error}"
                                  Icon="Delete24" />
                </ui:SpacingWrapPanel>
            </ui:SpacingStackPanel>

        </ui:SpacingStackPanel>
    </ScrollViewer>
</UserControl>
