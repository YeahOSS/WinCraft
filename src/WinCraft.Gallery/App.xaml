<Application x:Class="WinCraft.Gallery.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ui="clr-namespace:WinCraft.UI;assembly=WinCraft"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WinCraft;component/UI/Theme/Brushes.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/WinCraft;component/UI/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Thickness x:Key="PagePadding">32</Thickness>
            <Thickness x:Key="CardPadding">20</Thickness>
            <Thickness x:Key="CompactCardPadding">14</Thickness>
            <sys:Double x:Key="GalleryTileSize">168</sys:Double>
            <sys:Double x:Key="FormLabelWidth">120</sys:Double>
            <Style x:Key="GalleryCardStyle" TargetType="{x:Type ui:SuperellipseBorder}">
                <Setter Property="Background" Value="{DynamicResource BgSecondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
